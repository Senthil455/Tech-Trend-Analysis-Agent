# Copy this file to .env and replace the placeholder values.
# Never commit .env or real API keys.

OPENAI_API_KEY=your-openai-api-key
NEWS_API_KEY=your-newsapi-key
GITHUB_TOKEN=your-github-token
TREND_LIVE_DATA=1

# Optional runtime settings
# TREND_MAX_ITERATIONS=8
# TREND_MINIMUM_SOURCES=3
# TREND_MINIMUM_SCORE=60
# TREND_EMERGING_THRESHOLD=70
# TREND_GROWTH_THRESHOLD=30
# TREND_LOOKBACK_DAYS=7
# TREND_DB_URL=sqlite:///trend_memory.db
